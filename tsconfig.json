{
  "include": ["src/**/*"],
  "exclude": [
    ".github",
    ".husky",
    "node_modules",
    "build",
    "database/db_seed",
    "docker",
    "scripts"
  ],
  "compilerOptions": {
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./build",
    "paths": {
      "#src/*": ["./src/*"],
      "#types/*": ["./src/types/*"],
      "#schemas/*": ["./src/schemas/*"],
      "#utils/*": ["./src/utils/*"],
      "#tests/*": ["./tests/*"]
    },
    "module": "nodenext",
    "target": "ESNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force"
  }
}
