{
  "include": [
    "src/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "tests",
    "db_seed"
  ],
  "compilerOptions": {
    "types": ["node", "jest"],
    "rootDir": "./src",
    "outDir": "./build",
    // "paths": {
    //   "db_seed/*": [
    //     "./db_seed/*"
    //   ]
    // },
    "module": "nodenext",
    "target": "ESNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
  },
}