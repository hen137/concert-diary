{
  "name": "concert-diary",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "prod": "tsx --env-file=./env/.env.prod ./src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --env-file=./env/.env.test",
    "gen:db-types": "kysely-codegen --dialect postgres --env-file ./env/.env.dev --out-file ./src/types/database.d.ts",
    "gen:db-data-json": "tsx ./db_seed/data_json.ts",
    "dev": "tsx watch --env-file=./env/.env.dev ./src/index.ts",
    "dev:db-reset": "pnpm dev:db-wipe && pnpm gen:db-types && pnpm gen:db-data-json && pnpm dev:db-seed",
    "dev:db-wipe": "tsx --env-file=./env/.env.dev ./db_seed/db_wipe.ts",
    "dev:db-seed": "tsx --env-file=./env/.env.dev ./db_seed/db_seed.ts",
    "dev:signin": "tsx ./utils/bearer-token.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "better-auth": "^1.5.6",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "fastify-zod": "^1.4.0",
    "kysely": "^0.28.14",
    "pg": "^8.20.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.3.0",
    "kysely-codegen": "^0.19.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
