{
  "name": "concert-diary",
  "version": "1.0.0",
  "description": "",
  "exports": "./src/index.js",
  "imports": {
    "#src/*": "./src/*",
    "#schemas/*": "./src/schemas/*",
    "#types/*": "./src/types/*",
    "#utils/*": "./src/utils/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "build": "pnpm tsc",
    "prod:server": "node --env-file=./env/.env.prod ./build/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:db-types": "kysely-codegen --dialect postgres --env-file ./env/.env.dev --out-file ./src/types/database.d.ts",
    "gen:db-data-json": "tsx ./database/db_seed/data_json.ts",
    "dev:server": "tsx watch --env-file=./env/.env.dev ./src/index.ts",
    "dev:all-containers": "docker compose -f docker/compose.yaml up -d",
    "dev:build-and-run-containers": "pnpm dev:build-server-container && pnpm dev:all-containers",
    "dev:kill-all-containers": "docker compose -f docker/compose.yaml down",
    "dev:build-server-container": "docker build -f ./docker/dev.Dockerfile -t concert-diary:dev .",
    "dev:db-containers": "docker compose -f database/docker/db-compose.yaml up -d",
    "dev:kill-db-container": "docker compose -f database/docker/db-compose.yaml down",
    "dev:db-reset": "pnpm dev:db-wipe && pnpm gen:db-types && pnpm gen:db-data-json && pnpm dev:db-seed",
    "dev:db-wipe": "tsx --env-file=./env/.env.dev ./database/db_seed/db_wipe.ts",
    "dev:db-seed": "tsx --env-file=./env/.env.dev ./database/db_seed/db_seed.ts",
    "dev:signin": "tsx ./utils/bearer-token.ts",
    "prepare": "node .husky/install.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --max-warnings=0 --fix",
    "format": "prettier --write .",
    "format:file": "prettier --write",
    "check:pre-commit": "lint-staged"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@better-auth/api-key": "^1.6.9",
    "@fastify/auth": "^5.0.4",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "better-auth": "^1.6.9",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "fastify-zod": "^1.4.0",
    "kysely": "^0.28.17",
    "pg": "^8.20.0",
    "pg-format": "^1.0.4",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/pg-format": "^1.0.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "kysely-codegen": "^0.19.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "type": "module"
}
